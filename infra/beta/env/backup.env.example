# /etc/athenos/backup.env - settings of server/backup.sh and restore.sh
# (template infra/beta/env/backup.env.example). root:athenos 0640, no secrets:
# keys and remote credentials are files in /etc/athenos/secrets.

BACKUP_DIR=/var/backups/athenos
# Privacy policy: backups 14 days, then overwritten (local AND off-site).
BACKUP_RETENTION_DAYS=14
# Never fewer than this many dumps, even if they are older (backups broken
# for two weeks must not delete the last good ones).
BACKUP_MIN_KEEP=3
BACKUP_MIN_FREE_MB=2048
PG_BIN_DIR=/usr/lib/postgresql/16/bin
PGDATABASE=athenos
PGHOST=/var/run/postgresql

# Off-site copy: none | rsync | rclone. The off-site set mirrors the local
# one, so it also expires after BACKUP_RETENTION_DAYS.
OFFSITE_MODE=none

# rsync over SSH, e.g. a storage box (often port 23) at another provider:
#OFFSITE_MODE=rsync
#OFFSITE_RSYNC_TARGET=u123456@u123456.your-storagebox.de:athenos
#OFFSITE_RSYNC_SSH_PORT=23
#OFFSITE_RSYNC_SSH_KEY=/etc/athenos/secrets/offsite_ed25519
#OFFSITE_RSYNC_KNOWN_HOSTS=/etc/athenos/offsite_known_hosts

# or rclone, e.g. Infomaniak Swiss Backup (S3); its config holds the credentials:
#OFFSITE_MODE=rclone
#OFFSITE_RCLONE_REMOTE=swissbackup:athenos-db
#RCLONE_CONFIG=/etc/athenos/secrets/rclone.conf

# Optional: encrypt the off-site copies with age (public keys only on the
# server; the private key stays off the server, e.g. in the password manager).
#OFFSITE_AGE_RECIPIENTS_FILE=/etc/athenos/offsite-age-recipients.txt

# Optional dead man's switch: pinged after every successful nightly run
# (healthchecks.io, Better Stack heartbeat, ...). No ping = alert there.
#BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>
