# /etc/athenos/fenrir.env - environment of athenos.service (systemd
# EnvironmentFile). Template from infra/beta/env/fenrir.env.example.
#
# NO SECRETS IN THIS FILE. Every secret is a *_FILE variable pointing into
# /etc/athenos/secrets/ (0700 athenos:athenos, files 0600). Generate them with
#   sudo /usr/local/lib/athenos/secret.sh generate <name>
# or set one by hand (prompted, never echoed) with
#   sudo /usr/local/lib/athenos/secret.sh set <name>
# Owner root:athenos, mode 0640. Lines are KEY=VALUE, no quotes, no `export`.
# Changes need `sudo systemctl restart athenos`.

# --- Operating mode (SPEC §1) -------------------------------------------------
# prod = production in every component. Missing or unknown is production too.
FENRIR_ENV=prod
# Host config profile: config/beta.toml of the release (instead of prod.toml).
FENRIR_CONFIG_ENV=beta
FENRIR_PROFILE=BETA
FENRIR_USER=admin
FENRIR_RUNTIME_DIR=/var/lib/athenos/runtime

# --- Logs (SPEC §12: 7 days) ---------------------------------------------------
# Empty = the host logs to stdout only, i.e. journald (MaxRetentionSec=7day).
FENRIR_LOG_PATH=
FENRIR_DB_LOG_PATH=/var/log/athenos/db.log

# --- Real client IP behind Caddy (SPEC §2) --------------------------------------
# Caddy sets X-Real-IP {client_ip}; only loopback peers are believed.
FENRIR_SERVER__EDGE__CLIENT_IP_HEADER=x-real-ip
FENRIR_SERVER__EDGE__TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Public address -------------------------------------------------------------
ATHENOS_APP_URL=https://app.athenos.dev

# --- Control plane tokens (loopback only, used by fenrirctl and the SSH shell) --
FENRIR_HTTP_TOKEN_ADMIN_FILE=/etc/athenos/secrets/control-admin.token
FENRIR_HTTP_TOKEN_OPERATOR_FILE=/etc/athenos/secrets/control-operator.token
FENRIR_HTTP_TOKEN_VIEWER_FILE=/etc/athenos/secrets/control-viewer.token
# Required by the config loader; no module registry runs on the server.
FENRIR_REGISTRY_TOKEN_FILE=/etc/athenos/secrets/registry.token

# --- Service-to-service tokens (min. 32 chars, generated) ----------------------
# core and gateway -> auth-service
ATHENOS_INTERNAL_SERVICE_AUTH_TOKEN_FILE=/etc/athenos/secrets/athenos-internal.token
AUTH_INTERNAL_SERVICE_AUTH_TOKEN_FILE=/etc/athenos/secrets/athenos-internal.token
# auth-service and core -> notification-service
AUTH_NOTIFICATION_SERVICE_TOKEN_FILE=/etc/athenos/secrets/notify-service.token
NOTIFY_INTERNAL_SERVICE_AUTH_TOKEN_FILE=/etc/athenos/secrets/notify-service.token

# --- auth-service -----------------------------------------------------------------
# Pepper for PIN hashes: open codes survive a restart.
AUTH_PIN_PEPPER_FILE=/etc/athenos/secrets/auth-pin-pepper
# Never set in production (the services refuse to start): AUTH_ENV=dev,
# AUTH_DEV_PIN_SINK, ATHENOS_API_DEV_ENDPOINTS, FENRIR_DEV_MODULE_PATH,
# FENRIR_DEV_ENV_FILE, *_STORAGE_MODE=memory.

# --- Core: first admin and Athenos AI -------------------------------------------
# The setup token for the first administrator (/setup) is written by the core
# to its default place, /var/lib/athenos/modules-runtime/secrets/athenos-setup-token
# (0600), while no active user exists. No variable needed.
# Key for the suggestion tokens of Athenos AI (else random per start).
ATHENOS_INTEL_TOKEN_KEY_FILE=/etc/athenos/secrets/intel-token.key
# Model packages (read-only for the service), uploaded with infra/beta/model-upload.sh.
ATHENOS_MODELS_DIR=/opt/athenos/shared/models
ATHENOS_QUALITY_MODEL=athenos-quality/0.5.0-beta4

# --- Mail (notification-service, Mailgun EU over SMTP) --------------------------
SMTP_HOST=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_SECURITY=starttls
# The SMTP login of the Mailgun domain (Mailgun -> Sending -> Domain settings).
SMTP_USER=postmaster@mail.athenos.dev
SMTP_PASSWORD_FILE=/etc/athenos/secrets/smtp-password
# Optional during the closed test: only these recipients get mail.
#NOTIFY_RECIPIENT_ALLOWLIST=admin@example.org
