# /etc/athenos/monitor.env - health check and alerts (server/healthcheck.sh,
# server/alert.sh). Template infra/beta/env/monitor.env.example.
# root:athenos 0640.

# Where alerts go (required, else alerts only land in the journal).
ALERT_EMAIL_TO=admin@example.org
# Sender for the sendmail fallback (msmtp); must be allowed by the relay.
ALERT_EMAIL_FROM=alerts@mail.athenos.dev
# First try the local notification-service (Mailgun through Athenos itself).
ALERT_VIA_NOTIFICATION=true
# Repeat an unchanged problem every N hours.
ALERT_REPEAT_HOURS=6

PUBLIC_URL=https://app.athenos.dev
DISK_MAX_PERCENT=85
BACKUP_MAX_AGE_HOURS=26
CERT_MIN_DAYS=14
# Where the origin certificate (Cloudflare Origin CA, in Caddy) is checked.
ORIGIN_TLS_ADDRESS=127.0.0.1:443

# Optional dead man's switch for the health check itself (every 5 minutes
# when all checks are green). Combine with an external uptime monitor.
#HEALTHCHECK_HEARTBEAT_URL=https://hc-ping.com/<uuid>
