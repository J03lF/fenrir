# /etc/logrotate.d/athenos - the deploy log (written by root). The host rotates its own logs
# (app/db log and every module log: daily or 50 MB, archives deleted after
# 7 days, [telemetry.logs]); journald keeps 7 days.
/var/log/athenos-deploy.log {
	daily
	maxsize 10M
	rotate 7
	maxage 7
	missingok
	notifempty
	compress
	delaycompress
	create 0640 root root
}
