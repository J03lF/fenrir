# /etc/logrotate.d/athenos - files next to the journal: the host's DB log,
# the module logs (the host opens them with O_APPEND, so copytruncate is
# safe) and the deploy log. 7 days, at most 100 MB per file before that.
/var/log/athenos/*.log /var/lib/athenos/modules-runtime/logs/*.log {
	daily
	maxsize 100M
	rotate 7
	maxage 7
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
	su athenos athenos
}
